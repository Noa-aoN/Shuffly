<%# マイページ %>

<div class="max-w-6xl mx-auto px-6 py-6 md:py-8">
  <%# ユーザー情報ヘッダー %>
  <div class="shuffly-card px-6 md:px-10 py-8 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 rounded-full flex items-center justify-center shrink-0 bg-[rgba(139,92,246,0.10)] border border-[rgba(139,92,246,0.14)]">
          <%= image_tag 'icons/person_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 32, height: 32, class: "text-blue-600", alt: "ユーザーアイコン" %>
        </div>
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-[var(--shuffly-text)]"><%= @user.name.presence || @user.email.split('@').first %></h1>
          <p class="text-sm text-[var(--shuffly-text-secondary)]"><%= @user.email %></p>
        </div>
      </div>
      <%# 統計情報 %>
      <div class="flex flex-col sm:items-end gap-2 text-sm">
        <span class="shuffly-badge shuffly-badge-accent">
          <%= image_tag 'icons/event_note_24dp_1F1F1F.svg', width: 16, height: 16, class: "text-blue-600", alt: "" %>
          <%= @events_count %>件のイベント
        </span>
        <span class="shuffly-badge shuffly-badge-success">
          <%= image_tag 'icons/groups_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 16, height: 16, class: "text-green-600", alt: "" %>
          <%= @member_lists_count %>件のメンバーリスト
        </span>
      </div>
    </div>
  </div>

  <%# タブナビゲーション - 統合パーシャル使用 %>
  <div class="mb-6">
    <%= render 'shared/tabs',
          tabs: [
            { id: 'events', text: t("mypage.tabs.events"), icon: 'icons/event_note_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', path: mypage_path(tab: 'events'), data: { turbo: true } },
            { id: 'member_lists', text: t("mypage.tabs.member_lists"), icon: 'icons/groups_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', path: mypage_path(tab: 'member_lists'), data: { turbo: true } },
            { id: 'account', text: t("mypage.tabs.account"), icon: 'icons/settings_account_box_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', path: mypage_path(tab: 'account'), data: { turbo: true } }
          ],
          active_tab: @active_tab %>
  </div>

  <%# タブコンテンツ %>
  <% case @active_tab %>
  <% when 'member_lists' %>
    <div class="space-y-4">
      <% if @member_lists && @member_lists.any? %>
        <%# メンバーリストカード一覧 %>
        <% @member_lists.each do |member_list| %>
          <%= link_to edit_member_list_path(member_list), class: "shuffly-card-link block px-6 md:px-10 py-8 cursor-pointer group" do %>
            <div class="flex items-center justify-between gap-4">
              <div class="flex-1">
                <h3 class="font-semibold text-lg text-[var(--shuffly-text)] mb-2">
                  <%= member_list.name %>
                </h3>
                <div class="flex items-center gap-4 text-sm text-[var(--shuffly-text-secondary)]">
                  <span class="flex items-center gap-1">
                    <%= image_tag 'icons/groups_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 16, height: 16, alt: "メンバー数アイコン" %>
                    <%= member_list.members.count %>人
                  </span>
                  <span class="flex items-center gap-1">
                    <%= image_tag 'icons/schedule_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 16, height: 16, alt: "作成日アイコン" %>
                    <%= format_date(member_list.created_at) %>
                  </span>
                </div>
              </div>
              <svg class="w-5 h-5 text-[var(--shuffly-text-muted)] group-hover:text-[var(--shuffly-text-secondary)] transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          <% end %>
        <% end %>

        <%# 新規作成ボタン（中央配置） %>
        <div class="grid grid-cols-1 sm:grid-cols-1 gap-2 sm:place-items-center mt-4 w-full">
          <%= render 'shared/button',
                button_text: t("mypage.member_lists.create_new"),
                path: new_member_list_path,
                variant: 'primary',
                size: 'md',
                full_mobile: true,
                extra_class: 'w-full',
                icon: 'icons/add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
                icon_class: 'inline-block' %>
        </div>

        <%# ページネーション %>
        <% if @pagy_member_lists && @pagy_member_lists.pages > 1 %>
          <div class="flex justify-center mt-6">
            <%= pagy_nav(@pagy_member_lists, 'member_lists') %>
          </div>
        <% end %>
      <% else %>
        <div class="shuffly-card px-6 md:px-10 py-12 text-center">
          <%= image_tag 'icons/groups_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 64, height: 64, class: "mx-auto text-gray-300 mb-4", alt: "空のメンバーリストアイコン" %>
          <p class="mb-6 text-[var(--shuffly-text-secondary)]"><%= t("mypage.member_lists.empty") %></p>
          <div class="grid grid-cols-1 sm:grid-cols-1 gap-2 sm:place-items-center w-full">
            <%= render 'shared/button',
                  button_text: t("mypage.member_lists.create_new"),
                  path: new_member_list_path,
                  variant: 'primary',
                  size: 'lg',
                  full_mobile: true,
                  extra_class: 'w-full',
                  icon: 'icons/add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
                  icon_class: 'inline-block' %>
          </div>
        </div>
      <% end %>
    </div>

  <% when 'account' %>
    <div class="space-y-4">
      <%# アカウント情報カード %>
      <%= link_to edit_user_registration_path, class: "shuffly-card-link block px-6 md:px-10 py-8 cursor-pointer group" do %>
        <div class="flex items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center bg-[rgba(139,92,246,0.10)] border border-[rgba(139,92,246,0.14)]">
                <%= image_tag 'icons/person_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
                              width: 24,
                              height: 24,
                              class: 'text-blue-600',
                              alt: 'アカウントアイコン' %>
              </div>
              <div>
                <h3 class="text-xl font-bold text-[var(--shuffly-text)]"><%= t("mypage.account.title") %></h3>
              </div>
            </div>
            <div class="space-y-2 text-sm text-[var(--shuffly-text-secondary)] pl-13">
              <p><%= @user.email %></p>
              <% if @user.name.present? %>
                <p><%= @user.name %></p>
              <% end %>
            </div>
          </div>
          <svg class="w-5 h-5 text-[var(--shuffly-text-muted)] group-hover:text-[var(--shuffly-text-secondary)] transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      <% end %>

      <%# タイムゾーン設定カード %>
      <%= link_to timezone_settings_path, class: "shuffly-card-link block px-6 md:px-10 py-8 cursor-pointer group" do %>
        <div class="flex items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center bg-[rgba(96,165,250,0.10)] border border-[rgba(96,165,250,0.18)]">
                <%= image_tag 'icons/schedule_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
                              width: 24,
                              height: 24,
                              class: 'text-indigo-600',
                              alt: 'タイムゾーン設定アイコン' %>
              </div>
              <div>
                <h3 class="text-xl font-bold text-[var(--shuffly-text)]">タイムゾーン設定</h3>
              </div>
            </div>
            <div class="space-y-2 text-sm text-[var(--shuffly-text-secondary)] pl-13">
              <p>現在の設定：<%= User::AVAILABLE_TIMEZONES.find { |id, label| id == @user.timezone }&.second || @user.timezone %></p>
            </div>
          </div>
          <svg class="w-5 h-5 text-[var(--shuffly-text-muted)] group-hover:text-[var(--shuffly-text-secondary)] transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      <% end %>

      <%# スタイル設定カード %>
      <div class="shuffly-card-link shuffly-card-link-disabled relative block px-6 md:px-10 py-8 group overflow-visible" aria-disabled="true">
        <span class="shuffly-ribbon">準備中</span>
        <div class="flex items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center bg-[rgba(139,92,246,0.10)] border border-[rgba(139,92,246,0.14)]">
                <%= image_tag 'icons/palette_24dp_1F1F1F.svg',
                              width: 24,
                              height: 24,
                              class: 'text-purple-600',
                              alt: 'スタイル設定アイコン' %>
              </div>
              <div>
                <h3 class="text-xl font-bold text-[var(--shuffly-text)]">スタイル設定</h3>
              </div>
            </div>
            <div class="space-y-2 text-sm text-[var(--shuffly-text-secondary)] pl-13">
              <p>現在のテーマ：<%= User::THEME_LABELS[@user.theme_preference] || 'シンプル' %></p>
            </div>
          </div>
          <svg class="w-5 h-5 text-[var(--shuffly-text-muted)] group-hover:text-[var(--shuffly-text-secondary)] transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </div>

      <%# ログアウトボタン %>
      <div class="grid grid-cols-1 sm:grid-cols-1 gap-2 sm:place-items-center mt-4 w-full">
        <%= render 'shared/button',
              button_text: t("mypage.account.logout"),
              path: destroy_user_session_path,
              variant: 'danger',
              size: 'md',
              button_to_method: :delete,
              full_mobile: true,
              extra_class: 'w-full shadow-sm',
              icon: 'icons/logout_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg' %>
      </div>
    </div>

  <% else # events (default) %>
    <%# イベントカード一覧コンテナ %>
    <div class="space-y-4">
      <% if @events.any? %>
        <% @events.each do |event| %>
          <%= link_to event_path(event), class: "shuffly-card-link block px-6 md:px-10 py-8 cursor-pointer group" do %>
            <div class="flex items-center justify-between gap-4">
              <div class="flex-1">
                <h3 class="font-semibold text-lg text-[var(--shuffly-text)] mb-2">
                  <%= event.title.presence || "イベント #{event.id}" %>
                </h3>
                <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--shuffly-text-secondary)]">
                  <span class="flex items-center gap-1">
                    <%= image_tag 'icons/today_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 16, height: 16, alt: "作成日アイコン" %>
                    作成: <%= format_datetime(event.created_at) %>
                  </span>
                  <span class="flex items-center gap-1">
                    <%= image_tag 'icons/schedule_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 16, height: 16, alt: "更新日アイコン" %>
                    更新: <%= format_datetime(event.updated_at) %>
                  </span>
                  <span class="flex items-center gap-1">
                    <%= image_tag 'icons/groups_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg', width: 16, height: 16, alt: "メンバー数アイコン" %>
                    <%= event.members_list.count %>人
                  </span>
                  <%# 統計情報: シャッフル実行回数 %>
                  <% group_count = event.group_history.count %>
                  <% order_count = event.order_history.count %>
                  <% role_count = event.role_history.count %>
                  <% if group_count > 0 || order_count > 0 || role_count > 0 %>
                    <span class="shuffly-badge shuffly-badge-accent !px-2 !py-0.5 text-xs">
                      グループ: <strong><%= group_count %></strong>回
                    </span>
                    <span class="shuffly-badge shuffly-badge-success !px-2 !py-0.5 text-xs">
                      順番: <strong><%= order_count %></strong>回
                    </span>
                    <span class="shuffly-badge shuffly-badge-neutral !px-2 !py-0.5 text-xs">
                      役割: <strong><%= role_count %></strong>回
                    </span>
                  <% end %>
                </div>
              </div>
              <svg class="w-5 h-5 text-[var(--shuffly-text-muted)] group-hover:text-[var(--shuffly-text-secondary)] transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          <% end %>
        <% end %>

        <%# 新規作成ボタン %>
        <div class="grid grid-cols-1 sm:grid-cols-1 gap-2 sm:place-items-center mt-4 w-full">
          <%= render 'shared/button',
                button_text: t("mypage.events.create_new"),
                path: new_event_path,
                variant: 'primary',
                size: 'md',
                full_mobile: true,
                extra_class: 'w-full',
                icon: 'icons/add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
                icon_class: 'inline-block' %>
        </div>

        <%# ページネーション %>
        <% if @pagy_events && @pagy_events.pages > 1 %>
          <div class="flex justify-center mt-6">
            <%= pagy_nav(@pagy_events, 'events') %>
          </div>
        <% end %>
      <% else %>
        <%# 空の状態 %>
        <div class="shuffly-card px-6 md:px-10 py-16 text-center">
          <div class="w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6 bg-[rgba(139,92,246,0.10)] border border-[rgba(139,92,246,0.14)]">
            <%= image_tag 'icons/event_note_24dp_1F1F1F.svg', width: 48, height: 48, class: "text-blue-400", alt: "イベントアイコン" %>
          </div>
          <h3 class="text-xl font-semibold text-[var(--shuffly-text)] mb-2">イベントがありません</h3>
          <p class="mb-5 max-w-md mx-auto text-[var(--shuffly-text-secondary)]">
            最初のイベントを作成して、<br class="hidden sm:block">
            メンバーをシャッフルしましょう。<br>
            グループ分け、順番決め、役割分担ができます。
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-1 gap-2 sm:place-items-center w-full">
            <%= render 'shared/button',
                  button_text: t("mypage.events.create_new"),
                  path: new_event_path,
                  variant: 'primary',
                  size: 'lg',
                  full_mobile: true,
                  extra_class: 'w-full',
                  icon: 'icons/add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
                  icon_class: 'inline-block' %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= yield :javascript %>

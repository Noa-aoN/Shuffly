<%# タイムゾーン設定ページ %>

<div class="max-w-6xl mx-auto px-6 py-6 md:py-8">
  <%# ヘッダー %>
  <div class="mb-6">
    <%= link_to mypage_path(tab: 'account'), class: "inline-flex items-center gap-1 text-sm text-[var(--shuffly-text-secondary)] hover:text-[var(--shuffly-text)] mb-4" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      マイページに戻る
    <% end %>
    <h1 class="text-2xl md:text-3xl font-bold text-[var(--shuffly-text)]">タイムゾーン設定</h1>
    <p class="mt-2 text-[var(--shuffly-text-secondary)]">時刻表示をあなたの地域に合わせます</p>
  </div>

  <%# タイムゾーン設定フォーム %>
  <div class="shuffly-card px-6 md:px-10 py-8">
    <%= form_with(model: @user, url: settings_timezone_path, method: :patch, local: true, data: { turbo: false }) do |f| %>
      <div class="space-y-6">
        <%# タイムゾーン選択 %>
        <div>
          <%= f.label :timezone, class: "shuffly-label block mb-2" do %>
            タイムゾーン
          <% end %>
          <%= f.select(:timezone,
                       User::AVAILABLE_TIMEZONES,
                       { prompt: false },
                       class: "shuffly-select px-4 py-2.5 text-base") %>
          <p class="mt-1.5 text-xs text-[var(--shuffly-text-muted)]">
            現在の設定：<%= User::AVAILABLE_TIMEZONES.find { |id, label| id == @user.timezone }&.second || @user.timezone %>
          </p>
        </div>

        <%# 保存ボタン %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 w-full">
          <%= render 'shared/button',
                f: f,
                button_text: '設定を保存',
                variant: 'primary',
                size: 'md',
                full_mobile: true,
                full_width: true,
                extra_class: 'w-full',
                wrapper_class: 'mt-0 md:col-start-2',
                icon: 'icons/save_24dp_1F1F1F.svg',
                icon_class: 'inline-block' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

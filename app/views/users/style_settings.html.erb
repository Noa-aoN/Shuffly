<%# スタイル設定ページ %>

<div class="max-w-6xl mx-auto px-6 py-6 md:py-8">
  <%# ヘッダー %>
  <div class="mb-6">
    <%= link_to mypage_path(tab: 'account'), class: "inline-flex items-center gap-1 text-sm text-[var(--shuffly-text-secondary)] hover:text-[var(--shuffly-text)] mb-4" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      マイページに戻る
    <% end %>
    <h1 class="text-2xl md:text-3xl font-bold text-[var(--shuffly-text)]">スタイル設定</h1>
    <p class="mt-2 text-[var(--shuffly-text-secondary)]">テーマや表示設定を変更できます</p>
  </div>

  <%# スタイル設定フォーム %>
  <div class="shuffly-card px-6 md:px-10 py-8">
    <%= form_with(model: @user, url: settings_style_path, method: :patch, local: true, data: { turbo: false }) do |f| %>
      <div class="space-y-6">
        <%# テーマ選択 %>
        <div>
          <%= f.label :theme_preference, class: "shuffly-label block mb-3" do %>
            テーマを選択
          <% end %>

          <%# テーマ選択肢 %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% User::THEME_OPTIONS.each do |theme| %>
              <label class="relative flex cursor-pointer">
                <%= f.radio_button(:theme_preference, theme, class: "peer sr-only") %>
                <div
                  data-theme-card="<%= theme %>"
                  class="w-full p-4 border rounded-2xl transition-all hover:border-[var(--shuffly-border-strong)] hover:bg-[rgba(255,255,255,0.98)] border-[var(--shuffly-border)] bg-[rgba(255,255,255,0.94)]">
                  <div class="flex items-center gap-3">
                    <%# テーマプレビューアイコン %>
                    <div class="w-10 h-10 rounded-full flex items-center justify-center border <%=
                      case theme
                      when 'simple' then 'bg-[rgba(139,92,246,0.12)] border-[rgba(139,92,246,0.18)]'
                      when 'school' then 'bg-[rgba(245,158,11,0.10)] border-[rgba(245,158,11,0.16)]'
                      when 'work' then 'bg-[rgba(71,85,105,0.10)] border-[rgba(71,85,105,0.16)]'
                      when 'sports' then 'bg-[rgba(34,197,94,0.10)] border-[rgba(34,197,94,0.16)]'
                      when 'party' then 'bg-[rgba(236,72,153,0.10)] border-[rgba(236,72,153,0.16)]'
                      when 'casino' then 'bg-[rgba(239,68,68,0.10)] border-[rgba(239,68,68,0.16)]'
                      end
                    %>">
                      <span class="text-xl">
                        <%=
                          case theme
                          when 'simple' then '✨'
                          when 'school' then '📚'
                          when 'work' then '💼'
                          when 'sports' then '⚽'
                          when 'party' then '🎉'
                          when 'casino' then '🎰'
                          end
                        %>
                      </span>
                    </div>
                    <div class="flex-1">
                      <div class="font-medium text-[var(--shuffly-text)]"><%= User::THEME_LABELS[theme] %></div>
                      <div class="mt-1 flex flex-wrap items-center gap-2">
                        <% if @user.theme_preference == theme %>
                          <span class="shuffly-badge shuffly-badge-neutral">現在の設定</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </label>
            <% end %>
          </div>

          <p class="mt-1.5 text-xs text-[var(--shuffly-text-muted)]">
            現在のテーマ：<%= User::THEME_LABELS[@user.theme_preference] || 'シンプル' %>
          </p>
        </div>

        <%# 保存ボタン %>
        <div class="grid grid-cols-1 sm:grid-cols-1 gap-2 sm:place-items-center">
          <%= render 'shared/button',
                f: f,
                button_text: '設定を保存',
                variant: 'primary',
                size: 'md',
                full_mobile: true,
                extra_class: 'w-full',
                icon: 'icons/palette_24dp_1F1F1F.svg' %>
        </div>
      </div>
    <% end %>
  </div>

  <%# テーマ説明 %>
  <div class="mt-6 shuffly-panel-subtle px-6 py-6">
    <h3 class="font-semibold text-[var(--shuffly-text)] mb-3">テーマについて</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[var(--shuffly-accent)] border-2 border-[var(--shuffly-accent-hover)]"></span>
        <span class="text-[var(--shuffly-text-secondary)]"><span class="font-medium text-[var(--shuffly-text)]">シンプル</span> - シンプルで使いやすいデザイン</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-amber-500 border-2 border-amber-600"></span>
        <span class="text-[var(--shuffly-text-secondary)]"><span class="font-medium text-[var(--shuffly-text)]">スクール</span> - 学校向けの明るいデザイン</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-slate-600 border-2 border-slate-700"></span>
        <span class="text-[var(--shuffly-text-secondary)]"><span class="font-medium text-[var(--shuffly-text)]">ワーク</span> - ビジネス向けの落ち着いたデザイン</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-green-500 border-2 border-green-600"></span>
        <span class="text-[var(--shuffly-text-secondary)]"><span class="font-medium text-[var(--shuffly-text)]">スポーツ</span> - スポーツチーム向けの活気あるデザイン</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-pink-500 border-2 border-pink-600"></span>
        <span class="text-[var(--shuffly-text-secondary)]"><span class="font-medium text-[var(--shuffly-text)]">パーティ</span> - パーティー向けの楽しいデザイン</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-red-600 border-2 border-red-700"></span>
        <span class="text-[var(--shuffly-text-secondary)]"><span class="font-medium text-[var(--shuffly-text)]">カジノ</span> - カジノナイト向けのエレガントなデザイン</span>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  const form = document.querySelector('form[action="<%= settings_style_path %>"]');
  if (!form) return;

  const radios = form.querySelectorAll('input[name="user[theme_preference]"]');
  const selectedClasses = [
    'border-[rgba(139,92,246,0.30)]',
    'bg-[rgba(139,92,246,0.08)]',
    'shadow-[0_10px_24px_rgba(139,92,246,0.08)]'
  ];
  const defaultClasses = [
    'border-[var(--shuffly-border)]',
    'bg-[rgba(255,255,255,0.94)]'
  ];

  function clearVisualSelection() {
    form.querySelectorAll('[data-theme-card]').forEach((card) => {
      card.classList.remove(...selectedClasses);
      card.classList.add(...defaultClasses);
    });
  }

  function applyVisualSelection(theme) {
    clearVisualSelection();
    const card = form.querySelector(`[data-theme-card="${theme}"]`);
    if (!card) return;
    card.classList.remove(...defaultClasses);
    card.classList.add(...selectedClasses);
  }

  radios.forEach((radio) => {
    radio.addEventListener('change', () => {
      applyVisualSelection(radio.value);
    });
  });

  clearVisualSelection();
})();
</script>

<%# アカウント編集画面 %>

<%= render 'shared/devise_card', title: t("devise.registrations.edit.title") do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, id: 'edit-account-form' }, data: { turbo: false, controller: 'password-toggle' }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" do %>
        <%= t("activerecord.attributes.user.email") %>
      <% end %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" %>
    </div>

    <div class="mb-4">
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" do %>
        <%= t("activerecord.attributes.user.name") %>
      <% end %>
      <%= f.text_field :name, autocomplete: "name", class: "mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="mb-4 text-sm text-gray-600"><%= t("devise.registrations.edit.email_pending", email: resource.unconfirmed_email) %></div>
    <% end %>

    <div class="mb-4 relative">
      <%= f.label :password, class: "block text-sm font-medium text-gray-700" do %>
        <%= t("activerecord.attributes.user.password") %>
      <% end %>
      <div class="text-xs text-gray-500 mb-1"><%= t("devise.registrations.edit.password_hint") %></div>
      <div class="relative">
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-lg px-4 py-3 pr-12 text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition", id: "password-field" %>
        <button type="button" data-action="password-toggle#toggle" data-password-toggle-field-id="password-field" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none" aria-label="パスワードを表示">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" id="password-field-icon">
            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
      <% if @minimum_password_length %>
        <div class="text-xs text-gray-500 mt-1"><%= t("devise.registrations.edit.password_min_length", count: @minimum_password_length) %></div>
      <% end %>
    </div>

    <div class="mb-4 relative">
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" do %>
        <%= t("activerecord.attributes.user.password_confirmation") %>
      <% end %>
      <div class="relative">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-lg px-4 py-3 pr-12 text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition", id: "password-confirmation-field" %>
        <button type="button" data-action="password-toggle#toggle" data-password-toggle-field-id="password-confirmation-field" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none" aria-label="パスワードを表示">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" id="password-confirmation-field-icon">
            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>

    <div class="mb-4 relative">
      <%= f.label :current_password, class: "block text-sm font-medium text-gray-700" do %>
        <%= t("activerecord.attributes.user.current_password") %>
        <span class="text-red-500 ml-1">*</span>
      <% end %>
      <div class="text-xs text-gray-500 mb-1"><%= t("devise.registrations.edit.current_password_hint") %></div>
      <div class="relative">
        <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full border border-gray-300 rounded-lg px-4 py-3 pr-12 text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition", id: "current-password-field" %>
        <button type="button" data-action="password-toggle#toggle" data-password-toggle-field-id="current-password-field" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none" aria-label="パスワードを表示">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" id="current-password-field-icon">
            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>

  <% end %>

  <div class="grid grid-cols-1 gap-2 sm:grid-cols-3 mt-6">
    <%= render 'shared/button',
          button_text: "マイページへ戻る",
          path: mypage_path(tab: 'account'),
          variant: 'secondary',
          size: 'md',
          full_mobile: true,
          extra_class: 'w-full',
          icon: 'icons/keyboard_return_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
          wrapper_class: 'mt-0' %>

    <%= render 'shared/button',
          button_text: "情報を更新する",
          variant: 'primary',
          size: 'md',
          full_mobile: true,
          extra_class: 'w-full',
          icon: 'icons/save_24dp_1F1F1F.svg',
          is_button: true,
          html_type: 'submit',
          form_id: 'edit-account-form',
          wrapper_class: 'mt-0' %>

    <div class="mt-0">
      <%= form_with url: registration_path(resource_name),
            method: :delete,
            local: true,
            data: { turbo: false },
            html: {
              id: 'delete-account-form',
              class: 'w-full',
              onsubmit: "const src=document.getElementById('current-password-field'); const hidden=this.querySelector('input[name=\"user[current_password]\"]'); if(hidden && src){ hidden.value = src.value; } if(!hidden || !hidden.value.trim()){ alert('#{j t('devise.registrations.edit.current_password_required_for_delete')}'); if(src){ src.focus(); } return false; } return window.confirm('#{j t('devise.registrations.edit.cancel_account_confirm')}');"
            } do %>
        <%= hidden_field_tag 'user[current_password]', '' %>
        <%= render 'shared/button',
              button_text: "アカウントを削除する",
              variant: 'danger',
              size: 'md',
              full_mobile: true,
              extra_class: 'w-full',
              icon: 'icons/account_circle_off_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              is_button: true,
              html_type: 'submit',
              wrapper_class: 'mt-0' %>
      <% end %>
    </div>
  </div>

<% end %>

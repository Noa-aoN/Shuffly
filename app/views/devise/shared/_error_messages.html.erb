<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-red-800">
    <h3 class="font-semibold mb-2">
      <% headline_key =
           if resource.is_a?(User) && controller_name == 'registrations' && request.delete?
             "errors.messages.account_not_destroyed"
           elsif resource.is_a?(User)
             "errors.messages.account_not_saved"
           else
             "errors.messages.not_saved"
           end %>
      <%= I18n.t(headline_key,
                 count: resource.errors.count,
                 resource: resource.class.model_name.human.downcase) %>
    </h3>
    <ul class="list-disc list-inside text-sm space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% f = local_assigns.fetch(:f, nil) %>
<% button_text = local_assigns.fetch(:button_text, '') %>
<% path = local_assigns.fetch(:path, '#') %>
<% variant = local_assigns.fetch(:variant, 'primary') %>
<% size = local_assigns.fetch(:size, 'md') %>
<% full_mobile = local_assigns.fetch(:full_mobile, true) %>
<% full_width = local_assigns.fetch(:full_width, false) %>
<% disabled = local_assigns.fetch(:disabled, false) %>
<% extra_class = local_assigns.fetch(:extra_class, '') %>
<% id = local_assigns.key?(:id) ? local_assigns[:id] : nil %>
<% data_action = local_assigns.key?(:data_action) ? local_assigns[:data_action] : nil %>
<% button_to_method = local_assigns.key?(:button_to_method) ? local_assigns[:button_to_method] : nil %>
<% confirm_message = local_assigns.key?(:confirm_message) ? local_assigns[:confirm_message] : nil %>
<% is_button = local_assigns.key?(:is_button) ? local_assigns[:is_button] : nil %>
<% data = local_assigns.fetch(:data, {}) %>
<% wrapper_class = local_assigns.fetch(:wrapper_class, 'mt-2') %>
<% html_type = local_assigns.fetch(:html_type, nil) %>
<% form_id = local_assigns.fetch(:form_id, nil) %>

<%# 新規オプション: icon (asset パス or URL), icon_class, icon_alt, 既に構築済みの icon_html があれば優先する %>
<% icon_html = local_assigns.fetch(:icon_html, nil) %>
<% icon = local_assigns.fetch(:icon, nil) %>
<%# アイコンとテキストの間は全角スペース1つで制御する %>
<% icon_class = local_assigns.fetch(:icon_class, 'inline-block align-middle') %>
<% icon_alt = local_assigns.fetch(:icon_alt, '') %>
<% escaped_confirm = confirm_message.present? ? j(confirm_message) : nil %>

<% min_width_class = full_width ? '' : 'sm:min-w-[230px] lg:min-w-[310px]' %>
<% base = ["inline-flex items-center justify-center rounded-[12px] font-semibold tracking-[0.01em] focus:outline-none focus:ring-2 focus:ring-offset-2 transition px-6 py-3 border", min_width_class].join(' ').squeeze(' ').strip %>

<% size_classes = {
  'sm' => 'px-3 py-1 text-sm min-h-[44px]',
  'md' => 'px-4 py-2 text-sm min-h-[48px]',
  'lg' => 'px-5 py-3 text-base min-h-[52px]'
} %>

<% variant_classes = {
  'primary' => 'bg-[var(--shuffly-accent)] border-[rgba(124,92,255,0.18)] text-white hover:bg-[var(--shuffly-accent-hover)] focus:ring-[var(--shuffly-accent)] shadow-[0_8px_18px_rgba(124,92,255,0.14)]',
  'secondary' => 'bg-[rgba(255,255,255,0.82)] border-[var(--shuffly-border)] text-[var(--shuffly-text)] hover:bg-[rgba(255,255,255,0.90)] hover:border-[var(--shuffly-border-strong)] focus:ring-[var(--shuffly-accent)] shadow-[0_2px_8px_rgba(15,23,42,0.03)]',
  'tertiary' => 'bg-[rgba(248,250,252,0.68)] border-[rgba(217,224,234,0.82)] text-[var(--shuffly-text-secondary)] hover:bg-[var(--shuffly-bg-subtle)] hover:text-[var(--shuffly-text)] hover:border-[var(--shuffly-border-strong)] focus:ring-[var(--shuffly-accent)]',
  'danger' => 'bg-[var(--shuffly-danger)] border-[rgba(239,68,68,0.20)] text-white hover:bg-[#dc2626] focus:ring-[var(--shuffly-danger)] shadow-[0_8px_18px_rgba(239,68,68,0.14)]'
} %>

<% size_class = size_classes[size] || size_classes['md'] %>
<% var_class = variant_classes[variant] || variant_classes['primary'] %>
<% responsive_class =
  if full_width
    'w-full'
  elsif full_mobile
    'w-full sm:w-auto'
  else
    'inline-block'
  end %>
<% web_text_adjust = 'md:text-[15px]' %>
<% classes = [base, size_class, var_class, responsive_class, web_text_adjust, extra_class].join(' ').squeeze(' ').strip %>

<%# icon_html が未指定かつ icon が渡されている場合に生成する。
    CSS mask は本番配信やブラウザ差分で欠けやすいため、通常の img で描画する。 %>
<% if icon_html.blank? && icon.present? %>
  <% src = (begin; asset_path(icon) rescue icon; end) %>
  <% icon_tint_class = %w[primary danger].include?(variant) ? 'brightness-0 invert' : '' %>
  <% icon_html = image_tag(src, width: 20, height: 20, class: [icon_class, 'shrink-0', icon_tint_class].join(' ').squeeze(' ').strip, alt: (icon_alt.presence || '')) %>
<% end %>

<%# 新規: icon_class に 'icon_right' が含まれる場合はアイコンを右側に配置する %>
<% icon_right = icon_class.to_s.split(/\s+/).include?('icon_right') %>

<div class="<%= wrapper_class %>">
  <% if is_button %>
    <%# JavaScript用のボタン: type="button" %>
    <% button_opts = {
      class: classes,
      type: (html_type.presence || 'button'),
      id: id,
      disabled: disabled,
      data: data.merge(data_action.present? ? { action: data_action } : {})
    } %>
    <% button_opts[:form] = form_id if form_id.present? %>
    <% button_opts.delete_if { |_, v| v.nil? || v == {} } %>
    <%# アイコンがある場合はアイコンとテキストの間に全角スペースを1つ挿入する %>
    <% separator = icon_html.present? ? "　" : '' %>
    <% if icon_html.present? && icon_right %>
      <% inner = (content_tag(:span, button_text, class: 'font-semibold') + separator + icon_html.to_s).html_safe %>
    <% else %>
      <% inner = (icon_html.to_s + separator + content_tag(:span, button_text, class: 'font-semibold')).html_safe %>
    <% end %>
    <%= content_tag(:button, inner, button_opts) %>
  <% elsif f %>
    <% opts = { class: classes, id: id, disabled: disabled, type: 'submit' } %>
    <% if data_action.present? %>
      <% opts[:data] = { action: data_action } %>
    <% end %>
    <% opts.delete_if { |_, v| v.nil? } %>
    <% separator = icon_html.present? ? "　" : '' %>
    <% if icon_html.present? && icon_right %>
      <%= f.button opts do %>
        <%= (content_tag(:span, button_text, class: 'font-semibold') + separator + icon_html.to_s).html_safe %>
      <% end %>
    <% else %>
      <%= f.button opts do %>
        <%= (icon_html.to_s + separator + content_tag(:span, button_text, class: 'font-semibold')).html_safe %>
      <% end %>
    <% end %>
  <% elsif button_to_method.present? %>
    <%# button_to for non-GET requests (delete, post, etc.) %>
    <% button_opts = { class: classes, method: button_to_method, id: id } %>
    <% button_opts[:data] = { turbo: false } %>
    <% button_opts[:form] = { data: {} } %>
    <% if confirm_message.present? %>
      <% button_opts[:data][:confirm] = confirm_message %>
      <% button_opts[:form][:data][:turbo_confirm] = confirm_message %>
      <% button_opts[:form][:data][:confirm] = confirm_message %>
      <% button_opts[:form][:onsubmit] = "return window.confirm('#{escaped_confirm}')" %>
    <% end %>
    <% button_opts[:form].delete_if { |_, v| v.nil? || v == {} } if button_opts[:form].present? %>
    <% button_opts.delete_if { |_, v| v.nil? || v == {} } %>
    <%# ブロック形式でiconを含むHTMLを渡す %>
    <%= button_to path, button_opts do %>
      <% separator = icon_html.present? ? "　" : '' %>
      <% if icon_html.present? && icon_right %>
        <%= (content_tag(:span, button_text, class: 'font-semibold') + separator + icon_html.to_s).html_safe %>
      <% else %>
        <%= (icon_html.to_s + separator + content_tag(:span, button_text, class: 'font-semibold')).html_safe %>
      <% end %>
    <% end %>
  <% else %>
    <% link_opts = { class: classes, role: 'button', id: id, 'aria-disabled' => disabled ? 'true' : nil } %>
    <% link_data = data.dup %>
    <% link_data[:action] = data_action if data_action.present? %>
    <% link_opts[:data] = link_data if link_data.present? %>
    <% link_opts.delete_if { |_, v| v.nil? } %>
    <%# アイコンがある場合はアイコンとテキストの間に全角スペースを1つ挿入する %>
    <% separator = icon_html.present? ? "　" : '' %>
    <% if icon_html.present? && icon_right %>
      <% inner = (content_tag(:span, button_text, class: 'font-semibold') + separator + icon_html.to_s).html_safe %>
    <% else %>
      <% inner = (icon_html.to_s + separator + content_tag(:span, button_text, class: 'font-semibold')).html_safe %>
    <% end %>
    <%= link_to inner, path, link_opts %>
  <% end %>
</div>

<!-- ============================================ -->
<!-- ③ 結果表示パネル                            -->
<!-- シャッフル結果（グループ/順番/役割）の表示  -->
<!-- ============================================ -->
<div id="resultsCard" class="shuffly-panel px-6 py-8 md:px-10" data-page-reveal>

  <!-- パネルヘッダー -->
  <div class="flex items-start justify-between mb-3">
    <div class="flex items-center gap-3">
      <div class="shuffly-step-badge w-8 h-8 mb-4 rounded-full flex items-center justify-center font-bold">3</div>
      <h2 class="mb-3 text-xl md:text-2xl font-semibold tracking-[0.01em] text-[var(--shuffly-text)]">結果を確認する</h2>
    </div>
    <%# 履歴クリアボタン（右上に配置） %>
    <%= render 'shared/icon_button',
          icon: 'icons/delete_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
          path: '#',
          variant: 'default',
          title: '履歴をクリア',
          id: 'btn-clear-history' %>
  </div>

  <!-- ========================================== -->
  <!-- タブナビゲーション                         -->
  <!-- ========================================== -->
  <h3 class="shuffly-section-heading mb-2 font-semibold"><span class="shuffly-bullet">●</span> 見たい結果</h3>
  <div class="mb-5">
    <%= render 'shared/tabs',
          tabs: [
            { id: 'groups', text: 'グループ', icon: 'icons/diversity_3_24dp_1F1F1F.svg' },
            { id: 'order', text: '順番', icon: 'icons/format_list_numbered_24dp_1F1F1F.svg' },
            { id: 'roles', text: '役割', icon: 'icons/badge_24dp_1F1F1F.svg' }
          ],
          active_tab: 'groups' %>
  </div>

  <!-- ========================================== -->
  <!-- グループ分けパネル                         -->
  <!-- ========================================== -->
  <div id="panel-groups" class="result-panel">
    <h3 class="shuffly-section-heading mb-2 font-semibold"><span class="shuffly-bullet">●</span> グループの結果</h3>

    <!-- 結果出力エリア -->
    <textarea id="groupOutput" rows="10" readonly class="shuffly-output rounded-xl px-3 py-2 w-full mb-3 text-lg" data-controller="textarea-meter"></textarea>

    <div class="mb-6 flex flex-col gap-3">
      <!-- グループ表示オプション（折りたたみ可能） -->
      <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3">
        <button type="button" id="btn-toggle-options" class="shuffly-disclosure shuffly-disclosure-inline" aria-expanded="false">
          <span id="btn-toggle-options-text" class="shuffly-disclosure-text">表示の調整</span>
          <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, id: "btn-toggle-options-icon", class: "inline-block", alt: "展開アイコン" %>
        </button>

        <div id="optionsContainer" class="hidden pt-2">
          <h3 class="mb-2 font-semibold sr-only">表示の調整（詳細）</h3>

          <div class="flex flex-col gap-3">
            <!-- オプション: 表示内容 -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 w-full">
              <label class="text-sm text-[var(--shuffly-text-secondary)] mr-0 sm:mr-2 mb-1 sm:mb-0 min-w-[120px] sm:min-w-[140px]">見出しの出し方</label>
              <select id="displayFormatSelect" class="shuffly-input px-3 py-2 w-full sm:w-auto sm:min-w-[240px]">
                <option value="name">グループ名</option>
                <option value="name_break">グループ名 ※改行あり</option>
                <option value="name_count">グループ名＋人数</option>
                <option value="name_count_break" selected>グループ名＋人数 ※改行あり</option>
                <option value="none">なし</option>
              </select>
            </div>

            <!-- オプション: メンバーの区切り方 -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 w-full">
              <label class="text-sm text-[var(--shuffly-text-secondary)] mr-0 sm:mr-2 mb-1 sm:mb-0 min-w-[120px] sm:min-w-[140px]">メンバーの区切り方</label>
              <select id="separatorSelect" class="shuffly-input px-3 py-2 w-full sm:w-auto sm:min-w-[240px]">
                <option value="," selected>カンマ</option>
                <option value=" ">スペース</option>
                <option value="  ">ダブルスペース</option>
                <option value="\\t">タブ</option>
                <option value="\\n">改行</option>
              </select>
            </div>

            <!-- オプション: グループの区切り方 -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 w-full">
              <label class="text-sm text-[var(--shuffly-text-secondary)] mr-0 sm:mr-2 mb-1 sm:mb-0 min-w-[120px] sm:min-w-[140px]">グループ同士の区切り方</label>
              <select id="groupSeparatorSelect" class="shuffly-input px-3 py-2 w-full sm:w-auto sm:min-w-[240px]">
                <option value="none" selected>なし</option>
                <option value="space">空行</option>
                <option value="line">線</option>
                <option value="wave">波線</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- 統計情報（折りたたみ可能） -->
      <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3">
        <button type="button" id="btn-toggle-stats" class="shuffly-disclosure shuffly-disclosure-inline" aria-expanded="false">
          <span id="btn-toggle-stats-text" class="shuffly-disclosure-text">統計のメモ</span>
          <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, id: "btn-toggle-stats-icon", class: "inline-block", alt: "展開アイコン" %>
        </button>
        <div id="statsContainer" class="hidden pt-3">
          <textarea id="statsOutput" rows="10" readonly class="shuffly-output rounded-xl px-3 py-2 w-full text-sm mb-0"></textarea>
        </div>
      </div>
    </div>

    <!-- 回次表示インジケーター -->
    <div id="groupRoundHint" class="shuffly-indicator shuffly-indicator--warning text-base mt-1 mb-7 rounded-xl px-4 py-2">
      現在のグループ分け表示：<span class="font-bold">未実施</span>
    </div>

    <!-- 操作ボタングループ -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-2 w-full">
      <!-- 前回のグループ分けボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: raw('<span class="hidden sm:inline">前回のグループ分け</span><span class="inline sm:hidden">前回</span>'),
              id: 'btn-prev-groups',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/keyboard_double_arrow_left_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block' %>
      </div>

      <!-- 次回のグループ分けボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: raw('<span class="hidden sm:inline">次回のグループ分け</span><span class="inline sm:hidden">次回</span>'),
              id: 'btn-next-groups',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/keyboard_double_arrow_right_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block icon_right' %>
      </div>

      <!-- クリップボードにコピーボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: 'クリップボードにコピー',
              id: 'btn-copy-groupoutput',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/content_copy_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block' %>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 順番決めパネル                             -->
  <!-- ========================================== -->
  <div id="panel-order" class="result-panel hidden">
    <h3 class="shuffly-section-heading mb-2 font-semibold"><span class="shuffly-bullet">●</span> 順番の結果</h3>

    <!-- 結果出力エリア -->
    <textarea id="orderOutput" rows="10" readonly class="shuffly-output rounded-xl px-3 py-2 w-full text-lg mb-4" data-controller="textarea-meter"></textarea>

    <!-- 回次表示インジケーター -->
    <div id="orderRoundHint" class="shuffly-indicator shuffly-indicator--warning text-base mt-1 mb-5 rounded-xl px-4 py-2">
      現在の順番決め表示：<span class="font-bold">未実施</span>
    </div>

    <!-- 操作ボタングループ -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-2 w-full">
      <!-- 前回の順番決めボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: raw('<span class="hidden sm:inline">前回の順番決め</span><span class="inline sm:hidden">前回</span>'),
              id: 'btn-prev-order',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/keyboard_double_arrow_left_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block' %>
      </div>

      <!-- 次回の順番決めボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: raw('<span class="hidden sm:inline">次回の順番決め</span><span class="inline sm:hidden">次回</span>'),
              id: 'btn-next-order',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/keyboard_double_arrow_right_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block icon_right' %>
      </div>

      <!-- クリップボードにコピーボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: 'クリップボードにコピー',
              id: 'btn-copy-orderoutput',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/content_copy_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block' %>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 役割分担パネル                             -->
  <!-- ========================================== -->
  <div id="panel-roles" class="result-panel hidden">
    <h3 class="shuffly-section-heading mb-2 font-semibold"><span class="shuffly-bullet">●</span> 役割の結果</h3>

    <!-- 結果出力エリア -->
    <textarea id="rolesOutput" rows="10" readonly class="shuffly-output rounded-xl px-3 py-2 w-full text-lg mb-4" data-controller="textarea-meter"></textarea>

    <!-- 回次表示インジケーター -->
    <div id="rolesRoundHint" class="shuffly-indicator shuffly-indicator--warning text-base mt-1 mb-5 rounded-xl px-4 py-2">
      現在の役割分担表示：<span class="font-bold">未実施</span>
    </div>

    <!-- 操作ボタングループ -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-2 w-full">
      <!-- 前回の役割分担ボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: raw('<span class="hidden sm:inline">前回の役割分担</span><span class="inline sm:hidden">前回</span>'),
              id: 'btn-prev-roles',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/keyboard_double_arrow_left_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block' %>
      </div>

      <!-- 次回の役割分担ボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: raw('<span class="hidden sm:inline">次回の役割分担</span><span class="inline sm:hidden">次回</span>'),
              id: 'btn-next-roles',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/keyboard_double_arrow_right_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block icon_right' %>
      </div>

      <!-- クリップボードにコピーボタン -->
      <div>
        <%= render 'shared/button',
              f: nil,
              button_text: 'クリップボードにコピー',
              id: 'btn-copy-rolesoutput',
              path: '#',
              variant: 'tertiary',
              full_mobile: false,
              full_width: true,
              wrapper_class: '',
              extra_class: 'w-full',
              icon: 'icons/content_copy_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
              icon_class: 'inline-block' %>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 結果拡大表示モーダル                       -->
<!-- ========================================== -->
<div id="results-expand-modal" class="results-expand-modal hidden fixed inset-0 z-[80] items-center justify-center px-4" role="dialog" aria-modal="true" aria-labelledby="results-expand-title">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-results-expand-close></div>
  <div class="results-expand-modal-panel relative z-10 w-full max-w-3xl rounded-[28px] border border-[var(--shuffly-border)] bg-[rgba(255,255,255,0.97)] px-6 py-6 shadow-[0_24px_70px_rgba(15,23,42,0.18)]">
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 id="results-expand-title" class="text-xl font-bold text-[var(--shuffly-text)]">結果を拡大表示</h3>
      <button type="button" class="lp-modal-close" data-results-expand-close aria-label="閉じる">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <pre id="results-expand-body" class="results-expand-body whitespace-pre-wrap break-words"></pre>
  </div>
</div>

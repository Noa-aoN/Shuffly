<!-- ============================================ -->
<!-- ② 設定パネル                                -->
<!-- シャッフル設定（グループ/順番/役割）        -->
<!-- ============================================ -->
<div class="shuffly-panel px-6 py-8 md:px-10">

  <!-- パネルヘッダー -->
  <div class="flex items-start gap-3 mb-3">
    <div class="shuffly-step-badge w-8 h-8 rounded-full flex items-center justify-center font-bold">2</div>
    <h2 class="mb-3 text-xl md:text-2xl font-semibold tracking-[0.01em] text-[var(--shuffly-text)]">設定を選んで実行する</h2>
  </div>

  <!-- ========================================== -->
  <!-- タブナビゲーション                         -->
  <!-- ========================================== -->
  <div class="mb-5">
    <%= render 'shared/tabs',
          tabs: [
            { id: 'groups', text: 'グループ', icon: 'icons/diversity_3_24dp_1F1F1F.svg' },
            { id: 'order', text: '順番', icon: 'icons/format_list_numbered_24dp_1F1F1F.svg' },
            { id: 'roles', text: '役割', icon: 'icons/badge_24dp_1F1F1F.svg' }
          ],
          active_tab: 'groups',
          id_prefix: 'tab-settings' %>
  </div>

  <!-- ========================================== -->
  <!-- グループ分け設定パネル                     -->
  <!-- ========================================== -->
  <div id="panel-settings-groups" class="settings-panel">
    <div class="mb-4">
      <label class="shuffly-section-heading block mb-2"><span class="shuffly-bullet">●</span> グループの設定</label>

      <div class="flex flex-col gap-3 mb-4">
        <!-- オプション: グループ数 -->
        <div class="shuffly-setting-card shuffly-setting-card-primary rounded-2xl border border-[var(--shuffly-border)] px-4 py-4">
          <div class="mb-2 flex items-center gap-2">
            <label class="text-sm font-semibold text-[var(--shuffly-text)]">グループ数</label>
            <span class="shuffly-badge shuffly-badge-accent">必須</span>
          </div>
          <input id="groupCount" type="number" min="1" max="26" value="<%= event.group_count.presence || 3 %>" class="shuffly-input mt-1 px-2 py-1 mb-1">
          <div class="mt-3 flex flex-wrap gap-2" aria-label="よく使うグループ数">
            <% (2..10).each do |count| %>
              <button
                type="button"
                class="group-count-preset rounded-full border border-[var(--shuffly-border)] bg-white px-3 py-1.5 text-sm font-medium text-[var(--shuffly-text-secondary)] transition hover:border-[var(--shuffly-border-strong)] hover:text-[var(--shuffly-text)]"
                data-group-count-preset="<%= count %>"
                aria-label="<%= "#{count}グループを選択" %>">
                <%= count %>
              </button>
            <% end %>
          </div>
          <p class="shuffly-hint text-sm mt-2 mb-1">↑ 数字入力に加えて、よく使う数はボタンでも選べます。26グループが最大です。</p>
        </div>

        <!-- オプション: グループの名前 -->
        <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3" data-optional-card data-summary-source="customGroupNames" data-summary-kind="list" data-expanded="false">
          <button type="button" class="shuffly-optional-header mb-0 flex w-full items-center justify-between gap-3 text-left" data-optional-toggle aria-expanded="false">
            <div class="flex items-center gap-2">
              <label class="text-sm font-medium text-[var(--shuffly-text-secondary)]">グループの名前</label>
              <span class="shuffly-badge shuffly-badge-neutral">任意</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="shuffly-collapsed-summary text-sm text-[var(--shuffly-text-muted)]" data-optional-summary>未入力</span>
              <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, class: "shuffly-optional-toggle", data: { optional_toggle_icon: true }, alt: "展開アイコン" %>
            </div>
          </button>
          <div data-optional-content>
            <textarea id="customGroupNames" rows="2" class="shuffly-textarea shuffly-textarea-compact mt-1 px-3 py-2" placeholder="例：グループA, グループB, ..."></textarea>
            <p class="shuffly-hint text-sm mb-1">↑ 入力すると、ここで入れた名前がグループ名になります。グループ数よりこちらが優先されます。</p>
          </div>
        </div>

        <!-- オプション: 別々のグループにしたいメンバー -->
        <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3" data-optional-card data-summary-source="fixedMembersInput" data-summary-kind="list" data-expanded="false">
          <button type="button" class="shuffly-optional-header mb-0 flex w-full items-center justify-between gap-3 text-left" data-optional-toggle aria-expanded="false">
            <div class="flex items-center gap-2">
              <label class="text-sm font-medium text-[var(--shuffly-text-secondary)]">別々のグループにしたいメンバー</label>
              <span class="shuffly-badge shuffly-badge-neutral">任意</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="shuffly-collapsed-summary text-sm text-[var(--shuffly-text-muted)]" data-optional-summary>未入力</span>
              <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, class: "shuffly-optional-toggle", data: { optional_toggle_icon: true }, alt: "展開アイコン" %>
            </div>
          </button>
          <div data-optional-content>
            <textarea id="fixedMembersInput" rows="2" class="shuffly-textarea shuffly-textarea-compact mt-1 px-3 py-2" placeholder="例：メンバー3, メンバー5, ..."></textarea>
            <p class="shuffly-hint text-sm mt-1">↑ 入力したメンバーは、できるだけ別々のグループに分かれます。</p>
          </div>
        </div>

        <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3" data-optional-card data-summary-source="togetherMembersInput" data-summary-kind="group-list" data-expanded="false">
          <button type="button" class="shuffly-optional-header mb-0 flex w-full items-center justify-between gap-3 text-left" data-optional-toggle aria-expanded="false">
            <div class="flex items-center gap-2">
              <label class="text-sm font-medium text-[var(--shuffly-text-secondary)]">一緒のグループにしたいメンバー</label>
              <span class="shuffly-badge shuffly-badge-neutral">任意</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="shuffly-collapsed-summary text-sm text-[var(--shuffly-text-muted)]" data-optional-summary>未入力</span>
              <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, class: "shuffly-optional-toggle", data: { optional_toggle_icon: true }, alt: "展開アイコン" %>
            </div>
          </button>
          <div data-optional-content>
            <textarea id="togetherMembersInput" rows="2" class="shuffly-textarea shuffly-textarea-compact mt-1 px-3 py-2" placeholder="例：田中, 鈴木&#10;佐藤, 高橋"></textarea>
            <p class="shuffly-hint text-sm mt-1">↑ 同じ行に書いたメンバーは、できるだけ同じグループになります。</p>
          </div>
        </div>
      </div>

      <!-- グループサイズ表示インジケーター -->
      <div id="groupSizeHint" class="shuffly-indicator shuffly-indicator--warning text-base mt-2 mb-6 rounded-xl px-4 py-2">
        現在の1グループあたり：<span class="font-bold">未計算</span>
      </div>

      <!-- 注意事項 -->
      <p class="shuffly-hint text-sm">※<span class="underline decoration-dashed">グループ分けは複数回実行可能です。ボタンを押すたびに被りが最小限になるように振り分け、履歴も保持されます。</span></p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 順番決め設定パネル                         -->
  <!-- ========================================== -->
  <div id="panel-settings-order" class="settings-panel hidden">
    <div class="mb-4">
      <label class="shuffly-section-heading block mb-2"><span class="shuffly-bullet">●</span> 順番の設定</label>

      <div class="flex flex-col gap-3">
        <!-- オプション: 順番を固定したいメンバー -->
        <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3" data-optional-card data-summary-source="fixedOrderInput" data-summary-kind="list" data-expanded="false">
          <button type="button" class="shuffly-optional-header mb-0 flex w-full items-center justify-between gap-3 text-left" data-optional-toggle aria-expanded="false">
            <div class="flex items-center gap-2">
              <label class="text-sm font-medium text-[var(--shuffly-text-secondary)]">順番を固定したいメンバー</label>
              <span class="shuffly-badge shuffly-badge-neutral">任意</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="shuffly-collapsed-summary text-sm text-[var(--shuffly-text-muted)]" data-optional-summary>未入力</span>
              <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, class: "shuffly-optional-toggle", data: { optional_toggle_icon: true }, alt: "展開アイコン" %>
            </div>
          </button>
          <div data-optional-content>
            <textarea id="fixedOrderInput" rows="2" class="shuffly-textarea shuffly-textarea-compact px-3 py-2 mt-1" placeholder="例：1:田中, 5:鈴木"></textarea>
            <p class="shuffly-hint text-sm mt-1">↑ 「番号:名前」で入力すると、その位置に固定します。改行でもカンマ区切りでも入力できます。</p>
          </div>
        </div>

        <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3" data-optional-card data-summary-source="excludedOrderInput" data-summary-kind="list" data-expanded="false">
          <button type="button" class="shuffly-optional-header mb-0 flex w-full items-center justify-between gap-3 text-left" data-optional-toggle aria-expanded="false">
            <div class="flex items-center gap-2">
              <label class="text-sm font-medium text-[var(--shuffly-text-secondary)]">順番決めから外すメンバー</label>
              <span class="shuffly-badge shuffly-badge-neutral">任意</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="shuffly-collapsed-summary text-sm text-[var(--shuffly-text-muted)]" data-optional-summary>未入力</span>
              <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, class: "shuffly-optional-toggle", data: { optional_toggle_icon: true }, alt: "展開アイコン" %>
            </div>
          </button>
          <div data-optional-content>
            <textarea id="excludedOrderInput" rows="2" class="shuffly-textarea shuffly-textarea-compact mt-1 px-3 py-2" placeholder="例：メンバー2, メンバー7"></textarea>
            <p class="shuffly-hint text-sm mt-1">↑ 入力したメンバーは、今回の順番決めに入れません。</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 役割分担設定パネル                         -->
  <!-- ========================================== -->
  <div id="panel-settings-roles" class="settings-panel hidden">
    <div class="mb-4">
      <label class="shuffly-section-heading block mb-2"><span class="shuffly-bullet">●</span> 役割の設定</label>

      <div class="flex flex-col gap-3">
        <!-- オプション: 決めたい役割 -->
        <div class="shuffly-setting-card shuffly-setting-card-primary rounded-2xl border border-[var(--shuffly-border)] px-4 py-4">
          <div class="mb-2 flex items-center gap-2">
            <label class="text-sm font-semibold text-[var(--shuffly-text)]">決めたい役割</label>
            <span class="shuffly-badge shuffly-badge-accent">必須</span>
          </div>
          <div class="space-y-3">
            <div>
              <textarea id="rolesInput" rows="3" class="shuffly-textarea px-3 py-2" placeholder="例：司会&#10;書記:2&#10;受付"></textarea>
              <p class="shuffly-hint text-sm mt-1 mb-4">↑ 人数を増やしたいときは「役割名:人数」と入力できます。</p>
            </div>

            <div class="space-y-3">
              <div>
                <p class="text-xs font-medium text-[var(--shuffly-text-muted)]">会議・打ち合わせ</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% ["司会", "発表者", "書記", "タイムキーパー"].each do |role_name| %>
                    <div class="role-preset-control" data-role-preset-control="<%= role_name %>">
                      <button type="button"
                              class="role-preset-button rounded-full border border-[var(--shuffly-border)] bg-white px-3 py-1.5 text-sm font-medium text-[var(--shuffly-text-secondary)] transition hover:border-[var(--shuffly-border-strong)] hover:text-[var(--shuffly-text)]"
                              data-role-preset="<%= role_name %>"
                              data-role-category="meeting">
                        <%= role_name %>
                      </button>
                      <div class="role-inline-stepper is-inactive" data-role-stepper="<%= role_name %>">
                        <button type="button" data-role-adjust="<%= role_name %>" data-role-delta="-1" aria-label="<%= "#{role_name}の人数を減らす" %>">-</button>
                        <span class="min-w-[2rem] text-center text-xs font-semibold text-[var(--shuffly-text)]" data-role-count="<%= role_name %>">1</span>
                        <button type="button" data-role-adjust="<%= role_name %>" data-role-delta="1" aria-label="<%= "#{role_name}の人数を増やす" %>">+</button>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div>
                <p class="text-xs font-medium text-[var(--shuffly-text-muted)]">チーム・運営</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% ["リーダー", "サブリーダー", "連絡係", "まとめ役"].each do |role_name| %>
                    <div class="role-preset-control" data-role-preset-control="<%= role_name %>">
                      <button type="button"
                              class="role-preset-button rounded-full border border-[var(--shuffly-border)] bg-white px-3 py-1.5 text-sm font-medium text-[var(--shuffly-text-secondary)] transition hover:border-[var(--shuffly-border-strong)] hover:text-[var(--shuffly-text)]"
                              data-role-preset="<%= role_name %>"
                              data-role-category="team">
                        <%= role_name %>
                      </button>
                      <div class="role-inline-stepper is-inactive" data-role-stepper="<%= role_name %>">
                        <button type="button" data-role-adjust="<%= role_name %>" data-role-delta="-1" aria-label="<%= "#{role_name}の人数を減らす" %>">-</button>
                        <span class="min-w-[2rem] text-center text-xs font-semibold text-[var(--shuffly-text)]" data-role-count="<%= role_name %>">1</span>
                        <button type="button" data-role-adjust="<%= role_name %>" data-role-delta="1" aria-label="<%= "#{role_name}の人数を増やす" %>">+</button>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div>
                <p class="text-xs font-medium text-[var(--shuffly-text-muted)]">イベント</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% ["受付", "会場案内", "撮影", "誘導"].each do |role_name| %>
                    <div class="role-preset-control" data-role-preset-control="<%= role_name %>">
                      <button type="button"
                              class="role-preset-button rounded-full border border-[var(--shuffly-border)] bg-white px-3 py-1.5 text-sm font-medium text-[var(--shuffly-text-secondary)] transition hover:border-[var(--shuffly-border-strong)] hover:text-[var(--shuffly-text)]"
                              data-role-preset="<%= role_name %>"
                              data-role-category="event">
                        <%= role_name %>
                      </button>
                      <div class="role-inline-stepper is-inactive" data-role-stepper="<%= role_name %>">
                        <button type="button" data-role-adjust="<%= role_name %>" data-role-delta="-1" aria-label="<%= "#{role_name}の人数を減らす" %>">-</button>
                        <span class="min-w-[2rem] text-center text-xs font-semibold text-[var(--shuffly-text)]" data-role-count="<%= role_name %>">1</span>
                        <button type="button" data-role-adjust="<%= role_name %>" data-role-delta="1" aria-label="<%= "#{role_name}の人数を増やす" %>">+</button>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <p class="shuffly-hint text-sm mb-0">↑ ボタンを押すと追加できます。人数は右側で調整できます。</p>
            <div id="customRoleDefinitionsList" class="flex flex-wrap gap-2"></div>
          </div>
        </div>

        <div class="shuffly-setting-card shuffly-setting-card-optional rounded-2xl border border-[var(--shuffly-border)] px-4 py-3" data-optional-card data-summary-source="excludedRolesInput" data-summary-kind="list" data-expanded="false">
          <button type="button" class="shuffly-optional-header mb-0 flex w-full items-center justify-between gap-3 text-left" data-optional-toggle aria-expanded="false">
            <div class="flex items-center gap-2">
              <label class="text-sm font-medium text-[var(--shuffly-text-secondary)]">役割決めから外すメンバー</label>
              <span class="shuffly-badge shuffly-badge-neutral">任意</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="shuffly-collapsed-summary text-sm text-[var(--shuffly-text-muted)]" data-optional-summary>未入力</span>
              <%= image_tag "icons/expand_more_24dp_1F1F1F.svg", width: 20, height: 20, class: "shuffly-optional-toggle", data: { optional_toggle_icon: true }, alt: "展開アイコン" %>
            </div>
          </button>
          <div data-optional-content>
            <textarea id="excludedRolesInput" rows="2" class="shuffly-textarea shuffly-textarea-compact mt-1 px-3 py-2" placeholder="例：メンバー2, メンバー7"></textarea>
            <p class="shuffly-hint text-sm mt-1">↑ 入力したメンバーは、今回の役割決めに入れません。</p>
          </div>
        </div>

        <div id="rolesCountHint" class="shuffly-indicator shuffly-indicator--warning text-base mt-2 rounded-xl px-4 py-2">
          役割の合計人数：<span class="font-bold">未設定</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 実行ボタン（タブに応じて切り替え）         -->
  <!-- ========================================== -->

  <!-- グループ分け実行ボタン -->
  <div id="settings-action-groups" class="mt-7">
    <div class="mx-auto mb-3 grid max-w-[320px] grid-cols-1 gap-2">
      <%= render 'shared/button',
        f: nil,
        button_text: 'グループ分け実行',
        id: nil,
        path: '#',
        variant: 'primary',
        full_mobile: false,
        full_width: true,
        wrapper_class: '',
        extra_class: 'text-center px-6 py-3 rounded-xl shadow-sm w-full',
        icon: 'icons/play_arrow_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
        icon_class: 'inline-block' %>
    </div>
  </div>

  <!-- 順番決め実行ボタン -->
  <div id="settings-action-order" class="mt-7 hidden">
    <div class="mx-auto mb-3 grid max-w-[320px] grid-cols-1 gap-2">
      <%= render 'shared/button',
        f: nil,
        button_text: '順番決め実行',
        id: nil,
        path: '#',
        variant: 'primary',
        full_mobile: false,
        full_width: true,
        wrapper_class: '',
        extra_class: 'text-center px-6 py-3 rounded-xl shadow-sm w-full',
        icon: 'icons/play_arrow_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
        icon_class: 'inline-block' %>
    </div>
  </div>

  <!-- 役割決め実行ボタン -->
  <div id="settings-action-roles" class="mt-7 hidden">
    <div class="mx-auto mb-3 grid max-w-[320px] grid-cols-1 gap-2">
      <%= render 'shared/button',
        f: nil,
        button_text: '役割決め実行',
        id: nil,
        path: '#',
        variant: 'primary',
        full_mobile: false,
        full_width: true,
        wrapper_class: '',
        extra_class: 'text-center px-6 py-3 rounded-xl shadow-sm w-full',
        icon: 'icons/play_arrow_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
        icon_class: 'inline-block' %>
    </div>
  </div>
</div>

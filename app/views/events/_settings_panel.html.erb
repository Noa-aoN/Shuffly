<!-- ============================================ -->
<!-- ② 設定パネル                                -->
<!-- シャッフル設定（グループ/順番/役割）        -->
<!-- ============================================ -->
<div class="shuffly-panel px-6 py-8 md:px-10">

  <!-- パネルヘッダー -->
  <div class="flex items-start gap-3 mb-3">
    <div class="shuffly-step-badge w-8 h-8 rounded-full flex items-center justify-center font-bold">2</div>
    <h2 class="mb-3 text-xl md:text-2xl font-semibold tracking-[0.01em] text-[var(--shuffly-text)]">設定して実行する</h2>
  </div>

  <!-- ========================================== -->
  <!-- タブナビゲーション                         -->
  <!-- ========================================== -->
  <div class="mb-5">
    <%= render 'shared/tabs',
          tabs: [
            { id: 'groups', text: 'グループ', icon: 'icons/diversity_3_24dp_1F1F1F.svg' },
            { id: 'order', text: '順番', icon: 'icons/format_list_numbered_24dp_1F1F1F.svg' },
            { id: 'roles', text: '役割', icon: 'icons/badge_24dp_1F1F1F.svg' }
          ],
          active_tab: 'groups',
          id_prefix: 'tab-settings' %>
  </div>

  <!-- ========================================== -->
  <!-- グループ分け設定パネル                     -->
  <!-- ========================================== -->
  <div id="panel-settings-groups" class="settings-panel">
    <div class="mb-4">
      <label class="shuffly-label block mb-2"><span class="shuffly-bullet text-sm">●</span> グループ分けオプション</label>

      <div class="flex flex-col gap-3 mb-2">
        <!-- オプション: グループ数 -->
        <div>
          <label class="text-sm text-[var(--shuffly-text-secondary)]">グループ数*</label>
          <input id="groupCount" type="number" min="1" max="26" value="<%= event.group_count.presence || 3 %>" class="shuffly-input mt-1 px-2 py-1 mb-1">
          <p class="shuffly-hint text-sm mb-1">↑ 26グループが最大です。</p>
        </div>

        <!-- オプション: グループ名 -->
        <div>
          <label class="text-sm text-[var(--shuffly-text-secondary)]">グループ名（任意）</label>
          <textarea id="customGroupNames" rows="2" class="shuffly-textarea px-2 py-1 mt-1" placeholder="例：グループA, グループB, ..."></textarea>
          <p class="shuffly-hint text-sm mb-1">↑ 改行またはカンマ区切りで入力してください。入力があるとグループ数が無視され、グループ名の数が反映されます。</p>
        </div>
      </div>

      <!-- オプション: 分散固定メンバー -->
      <div>
        <label class="text-sm text-[var(--shuffly-text-secondary)]">分散固定メンバー（任意）</label>
        <textarea id="fixedMembersInput" rows="2" class="shuffly-textarea px-2 py-1 mt-1" placeholder="例：メンバー3, メンバー5, ..."></textarea>
        <p class="shuffly-hint text-sm mb-6">↑ 改行またはカンマ区切りで入力してください。入力メンバーは可能な限り分散して各グループに固定されます。</p>
      </div>

      <!-- グループサイズ表示インジケーター -->
      <div id="groupSizeHint" class="shuffly-indicator shuffly-indicator--warning text-base mt-1 mb-5 rounded-xl px-4 py-2">
        現在の1グループあたり：<span class="font-bold">未計算</span>
      </div>

      <!-- 注意事項 -->
      <p class="shuffly-hint text-sm">※<span class="underline decoration-dashed">グループ分けは複数回実行可能です。ボタンを押すたびに被りが最小限になるように振り分け、履歴も保持されます。</span></p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 順番決め設定パネル                         -->
  <!-- ========================================== -->
  <div id="panel-settings-order" class="settings-panel hidden">
    <div class="mb-4">
      <label class="shuffly-label block mb-2"><span class="shuffly-bullet text-sm">●</span> 順番決めオプション</label>

      <!-- オプション: 順番固定メンバー -->
      <div class="mb-2">
        <label class="text-sm text-[var(--shuffly-text-secondary)]">順番固定メンバー（任意）</label>
        <textarea id="fixedOrderInput" rows="3" class="shuffly-textarea px-2 py-1 mt-1" placeholder="例：1:メンバー3, 5:メンバー1, ..."></textarea>
        <p class="shuffly-hint text-sm mt-1">↑ 改行またはカンマ区切りで「番号:メンバー名」と入力してください。固定指定します。無効な指定は無視されます。</p>
      </div>

      <!-- 注意事項 -->
      <p class="shuffly-hint text-sm mt-1">固定指定なしなら全員ランダムに順番が決まります。</p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 役割分担設定パネル                         -->
  <!-- ========================================== -->
  <div id="panel-settings-roles" class="settings-panel hidden">
    <div class="mb-4">
      <label class="shuffly-label block mb-2"><span class="shuffly-bullet text-sm">●</span> 役割決めオプション</label>

      <!-- オプション: 役割名 -->
      <label class="text-sm text-[var(--shuffly-text-secondary)]">役割名*</label>
      <textarea id="rolesInput" rows="3" class="shuffly-textarea px-2 py-1 mt-1" placeholder="例：司会, 書記, ..."></textarea>
      <p class="shuffly-hint text-sm mt-1">↑ 改行またはカンマ区切りで役割名を入力してください。割り当てはランダムです。</p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 実行ボタン（タブに応じて切り替え）         -->
  <!-- ========================================== -->

  <!-- グループ分け実行ボタン -->
  <div id="settings-action-groups" class="mt-7">
    <div class="mx-auto mb-3 grid max-w-[320px] grid-cols-1 gap-2">
      <%= render 'shared/button',
        f: nil,
        button_text: 'グループ分け実行',
        id: nil,
        path: '#',
        variant: 'primary',
        full_mobile: false,
        full_width: true,
        wrapper_class: '',
        extra_class: 'text-center px-6 py-3 rounded-xl shadow-sm w-full',
        icon: 'icons/play_arrow_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
        icon_class: 'inline-block' %>
    </div>
  </div>

  <!-- 順番決め実行ボタン -->
  <div id="settings-action-order" class="mt-4 hidden">
    <div class="mx-auto mb-3 grid max-w-[320px] grid-cols-1 gap-2">
      <%= render 'shared/button',
        f: nil,
        button_text: '順番決め実行',
        id: nil,
        path: '#',
        variant: 'primary',
        full_mobile: false,
        full_width: true,
        wrapper_class: '',
        extra_class: 'text-center px-6 py-3 rounded-xl shadow-sm w-full',
        icon: 'icons/play_arrow_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
        icon_class: 'inline-block' %>
    </div>
  </div>

  <!-- 役割決め実行ボタン -->
  <div id="settings-action-roles" class="mt-4 hidden">
    <div class="mx-auto mb-3 grid max-w-[320px] grid-cols-1 gap-2">
      <%= render 'shared/button',
        f: nil,
        button_text: '役割決め実行',
        id: nil,
        path: '#',
        variant: 'primary',
        full_mobile: false,
        full_width: true,
        wrapper_class: '',
        extra_class: 'text-center px-6 py-3 rounded-xl shadow-sm w-full',
        icon: 'icons/play_arrow_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg',
        icon_class: 'inline-block' %>
    </div>
  </div>
</div>

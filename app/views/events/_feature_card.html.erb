<!-- ============================================ -->
<!-- 機能カードパーシャル                        -->
<!-- トップページで使用する機能説明カード        -->
<!-- ============================================ -->

<%
  # ========================================
  # パラメータ設定
  # ========================================
  # - icon: アイコンパス（オプション）
  # - icon_bg: アイコン背景色（任意の追加クラス）
  # - card_bg: カード背景色（任意の追加クラス）
  # - title: タイトル
  # - description: 説明（HTMLセーフ）
  # - number: 番号（オプション、使い方カードの場合）
  # - wrapper: ラッパー要素が必要か（デフォルト: false）
  # - text_center: テキスト中央揃え（デフォルト: true）

  icon ||= nil
  icon_bg ||= ''
  card_bg ||= ''
  number ||= nil
  wrapper ||= false
  text_center ||= true
  detail_id ||= nil
  detail_title ||= nil
  detail_copy ||= nil
  detail_sample_title ||= nil
  detail_sample_lines ||= []
  clickable = detail_id.present?
  detail_badge ||= nil
%>

<!-- ========================================== -->
<!-- ラッパー開始（オプション）                 -->
<!-- ========================================== -->
<% if wrapper %>
  <div>
<% end %>

    <!-- ========================================== -->
    <!-- カード本体                                 -->
    <!-- ========================================== -->
    <% card_classes = "index-feature-card shuffly-feature-card #{card_bg} flex flex-col items-center #{'text-center' if text_center}".squish %>
    <% if clickable %>
      <button type="button"
              class="<%= card_classes %> lp-feature-card-button relative"
              data-action="click->lp-cards#openCard"
              data-lp-cards-detail-id-param="<%= detail_id %>">
    <% else %>
      <div class="<%= card_classes %>">
    <% end %>
      <% if clickable %>
        <span class="lp-feature-card-hint" aria-hidden="true">+ 詳細</span>
      <% end %>
      <!-- 番号またはアイコン表示 -->
      <% if number %>
        <!-- 番号表示（使い方カード用） -->
        <div class="shuffly-feature-step <%= icon_bg %>"><%= number %></div>
      <% elsif icon %>
        <!-- アイコン表示 -->
        <div class="shuffly-feature-icon <%= icon_bg %>">
          <%= image_tag icon, width: 24, height: 24, alt: "#{title}アイコン" %>
        </div>
      <% end %>

      <!-- タイトル -->
      <h4 class="mb-2 text-base font-semibold text-[var(--shuffly-text)]"><%= title %></h4>

      <!-- 説明文 -->
      <p class="text-sm text-[var(--shuffly-text-secondary)]"><%= raw description %></p>
    <% if clickable %>
      </button>
      <template data-lp-cards-target="detail" data-detail-id="<%= detail_id %>" data-detail-title="<%= detail_title %>" data-detail-badge="<%= detail_badge %>">
        <div class="space-y-5">
          <p class="text-sm leading-7 text-[var(--shuffly-text-secondary)]"><%= raw detail_copy %></p>
          <% if detail_sample_lines.present? %>
            <div class="rounded-2xl border border-[var(--shuffly-border)] bg-[rgba(255,255,255,0.9)] px-4 py-4">
              <% if detail_sample_title.present? %>
                <p class="text-xs font-semibold tracking-[0.08em] text-[var(--shuffly-text-muted)]"><%= detail_sample_title %></p>
              <% end %>
              <div class="mt-3 space-y-2">
                <% detail_sample_lines.each do |line| %>
                  <div class="rounded-xl bg-[rgba(124,92,255,0.08)] px-3 py-2 text-sm text-[var(--shuffly-text)]"><%= line %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </template>
    <% else %>
      </div>
    <% end %>

<!-- ========================================== -->
<!-- ラッパー終了（オプション）                 -->
<!-- ========================================== -->
<% if wrapper %>
  </div>
<% end %>

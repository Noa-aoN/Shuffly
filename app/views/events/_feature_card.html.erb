<!-- ============================================ -->
<!-- 機能カードパーシャル                        -->
<!-- トップページで使用する機能説明カード        -->
<!-- ============================================ -->

<%
  # ========================================
  # パラメータ設定
  # ========================================
  # - icon: アイコンパス（オプション）
  # - icon_bg: アイコン背景色（任意の追加クラス）
  # - card_bg: カード背景色（任意の追加クラス）
  # - title: タイトル
  # - description: 説明（HTMLセーフ）
  # - number: 番号（オプション、使い方カードの場合）
  # - wrapper: ラッパー要素が必要か（デフォルト: false）
  # - text_center: テキスト中央揃え（デフォルト: true）

  icon ||= nil
  icon_bg ||= ''
  card_bg ||= ''
  number ||= nil
  wrapper ||= false
  text_center ||= true
%>

<!-- ========================================== -->
<!-- ラッパー開始（オプション）                 -->
<!-- ========================================== -->
<% if wrapper %>
  <div>
<% end %>

    <!-- ========================================== -->
    <!-- カード本体                                 -->
    <!-- ========================================== -->
    <div class="index-feature-card shuffly-feature-card <%= card_bg %> flex flex-col items-center <%= 'text-center' if text_center %>">
      <!-- 番号またはアイコン表示 -->
      <% if number %>
        <!-- 番号表示（使い方カード用） -->
        <div class="shuffly-feature-step <%= icon_bg %>"><%= number %></div>
      <% elsif icon %>
        <!-- アイコン表示 -->
        <div class="shuffly-feature-icon <%= icon_bg %>">
          <%= image_tag icon, width: 24, height: 24, alt: "#{title}アイコン" %>
        </div>
      <% end %>

      <!-- タイトル -->
      <h4 class="mb-2 text-base font-semibold text-[var(--shuffly-text)]"><%= title %></h4>

      <!-- 説明文 -->
      <p class="text-sm text-[var(--shuffly-text-secondary)]"><%= raw description %></p>
    </div>

<!-- ========================================== -->
<!-- ラッパー終了（オプション）                 -->
<!-- ========================================== -->
<% if wrapper %>
  </div>
<% end %>
